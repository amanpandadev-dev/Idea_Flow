# Database Configuration
DATABASE_URL=postgresql://postgres:Vamsi123.@localhost:5432/IdeaFlow

# Ollama Configuration (REQUIRED - for local AI)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REASONING_MODEL=llama3.1

# Embedding Provider (always llama)
EMBEDDING_PROVIDER=llama

# External APIs
TAVILY_API_KEY=your-tavily-api-key-here

# JWT Secrets (IMPORTANT: Generate strong random strings for production)
JWT_SECRET=your-jwt-secret-min-32-chars-long
REFRESH_SECRET=your-refresh-secret-min-32-chars-long
SESSION_SECRET=your-session-secret-min-32-chars-long

# Server Configuration
PORT=3001
NODE_ENV=development

