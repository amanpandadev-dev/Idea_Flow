# .env Configuration for TIER-1 Enhancements

# Add these environment variables to your .env file:

# ============================================
# TIER-1 ENHANCEMENT CONFIGURATION
# ============================================

# Vector Store TTL (Time To Live)
# How long should ephemeral vector collections persist before cleanup
# Default: 24 hours
VECTOR_STORE_TTL_HOURS=24

# Vector Cleanup Job Interval
# How often the cleanup job should run (in minutes)
# Default: 60 minutes (1 hour)
VECTOR_CLEANUP_INTERVAL_MINS=60

# ============================================
# EXISTING CONFIGURATION (keep these)
# ============================================

# Your existing JWT secrets, database config, etc...
